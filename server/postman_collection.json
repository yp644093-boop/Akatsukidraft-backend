    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post or Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Understanding True Peace\",\n  \"description\": \"An article exploring peace and conflict\",\n  \"content\": \"Real peace cannot exist without understanding the pain of others...\",\n  \"category\": \"Philosophy\",\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            }
          }
        },
        {
          "name": "Get Public Approved Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=1&limit=10&sort=latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "latest" }
              ]
            }
          }
        },
        {
          "name": "Get Public Post By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Get My Posts (Drafts, Pending, Approved)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/posts/my-posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "my-posts"]
            }
          }
        },
        {
          "name": "Update Owned Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Philosophy of Peace\",\n  \"content\": \"Refined content requiring fresh approval.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Submit Draft For Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "submit"]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System Admin\",\n  \"email\": \"admin@akatsuki.io\",\n  \"password\": \"AdminSecret123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "register"]
            }
          }
        },
        {
          "name": "Admin Login (Separate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@akatsuki.io\",\n  \"password\": \"AdminSecret123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "login"]
            }
          }
        },
        {
          "name": "Get Pending Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/posts/pending?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "posts", "pending"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Approve Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/posts/approve/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "posts", "approve", "{{postId}}"]
            }
          }
        },
        {
          "name": "Reject Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Please add more details to the introduction and format paragraphs.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/posts/reject/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "posts", "reject", "{{postId}}"]
            }
          }
        }
      ]
    },
